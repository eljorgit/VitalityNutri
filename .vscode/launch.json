{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend + Chrome Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm --prefix frontend run dev",
      "serverReadyAction": {
        "pattern": "Local:\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/frontend"
      }
    }
  ]
}
