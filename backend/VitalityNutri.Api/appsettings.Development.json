{
  "ApiConfiguration": {
    "Database": {
      "ApplyMigrations": true
    },
    "Telemetry": {
      "Sentry": {
        "Environment": "development"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}