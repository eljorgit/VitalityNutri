{
  "ApiConfiguration": {
    "App": { "Mode": "Oss" },
    "Database": {
      "Provider": "MySql",
      "ApplyMigrations": false
    },
    "Security": { "UseHttpsRedirection": false },
    "Auth": {
      "Issuer": "VitalityNutri",
      "Audience": "VitalityNutriApp",
      "ExpirationMinutes": 1440
    },
    "Upload": { "MaxFileSizeMb": 15 },
    "Ai": {
      "UseOmniRoute": false,
      "OmniRoute": {
        "Url": "http://localhost:20128/v1"
      },
      "Pdf": { "SelectableTextThreshold": 100 },
      "FallbackChains": {
        "PlanText": "openai:gpt-5-mini,anthropic:claude-sonnet-4-5,omniroute:strict-json",
        "BatchCooking": "openai:gpt-5-mini,anthropic:claude-sonnet-4-5,omniroute:strict-json",
        "RecipeAi": "openai:gpt-5-mini,anthropic:claude-sonnet-4-5,omniroute:strict-json",
        "RecipeVision": "anthropic:claude-sonnet-4-5,openai:gpt-5-mini,omniroute:vision-multimodal,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash",
        "Translation": "openai:gpt-5-mini,omniroute:light-free",
        "PlanVision": "anthropic:claude-sonnet-4-5,openai:gpt-5-mini,omniroute:vision-multimodal,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash"
      },
      "Providers": {
        "Gemini": {
          "TimeoutSeconds": 500
        }
      }
    },
    "Telemetry": {
      "Sentry": {
        "Environment": "release"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}