# ─── Required ───────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Server ────────────────────────────────────────────
# PORT: HTTP server port (default: 5027)
PORT=5027

# NODE_ENV: "development" or "production" (default: development)
NODE_ENV="development"

# APP_URL: Public URL where this instance is hosted.
# Used for self-referential links, OpenGraph meta tags, and share buttons.
# In production, set this to your actual domain (e.g. https://vitalitynutri.com).
# If unset, the server auto-detects localhost in development.
APP_URL=""

# SITE_VISIBILITY: "public" or "local" (default: local)
# When "local", share buttons will show a warning that links may not be
# accessible to others. Set to "public" once deployed to a public URL.
# Auto-detected from APP_URL if not explicitly set.
SITE_VISIBILITY="local"

# ─── Optional ──────────────────────────────────────────
# UNSPLASH_ACCESS_KEY: Unsplash API key for recipe image search.
# Obtain from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY="MY_UNSPLASH_ACCESS_KEY"

# VITE_LANGUAGE: Default app language ("en" or "es").
# This variable is read at runtime by the i18n config on the client side.
VITE_LANGUAGE="en"
