# VitalityNutri frontend environment
# Copy to .env.frontend. Values in this file are public browser configuration.
# Never place passwords, database URLs, API keys, or tokens here.

# Initial UI language: en or es
FRONTEND_LANGUAGE=es

# Site visibility: public when deployed on a reachable domain; local for homelab/workstation-only access
FRONTEND_SITE_VISIBILITY=public

# Optional: Dedicated API URL for split-domain production (e.g. https://api.vitalitynutri.com)
# Leave blank to use the built-in Nginx /api proxy
FRONTEND_API_URL=

# Max PDF file size (in MB) accepted in the UI
FRONTEND_MAX_UPLOAD_SIZE_MB=15

# Max request body size for Nginx (should be ~1.5x of FRONTEND_MAX_UPLOAD_SIZE_MB due to base64 encoding overhead)
NGINX_CLIENT_MAX_BODY_SIZE=25M