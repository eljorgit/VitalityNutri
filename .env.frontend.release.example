# VitalityNutri frontend release environment
# Copy to .env.frontend.release on the deployment host.

# Application mode: saas (multi-tenant cloud with login portal) or oss (single-tenant local zero-auth)
FRONTEND_APP_MODE=saas

# Site visibility: public when deployed on a reachable domain
FRONTEND_SITE_VISIBILITY=public

# Optional: Dedicated API URL for split-domain production
# Leave blank to use the built-in Nginx /api proxy
FRONTEND_API_URL=

# Max PDF file size (in MB) accepted in the UI
FRONTEND_MAX_UPLOAD_SIZE_MB=15

# Max request body size for Nginx (should be ~1.5x of FRONTEND_MAX_UPLOAD_SIZE_MB)
NGINX_CLIENT_MAX_BODY_SIZE=25M
