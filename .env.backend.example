# VitalityNutri backend environment
# Copy to .env.backend and replace every CHANGE_ME value.
# This file is loaded only by the backend container. Never expose these values to Vite.

# Keep only private/secret values in this file.
# Non-sensitive defaults (mode, provider, URLs, model aliases, etc.) belong in appsettings.
# Set this to Development on a development VPS; Production is the container default.
ASPNETCORE_ENVIRONMENT=Production

# Database secret
ApiConfiguration__ConnectionStrings__Default=Server=host.docker.internal;Port=3306;Database=vitalitynutri;User ID=CHANGE_ME;Password=CHANGE_ME;SslMode=Preferred;

# AI secret keys
ApiConfiguration__Ai__OmniRoute__ApiKey=CHANGE_ME
ApiConfiguration__Ai__Providers__Gemini__ApiKey=CHANGE_ME
ApiConfiguration__Ai__Providers__Groq__ApiKey=CHANGE_ME

# AI platform credits (SaaS): weekly quota consumed by server-side platform AI calls.
ApiConfiguration__Ai__Credits__WeeklyPlatformLimit=10

# Transactional email (SMTP). Required in SaaS mode for email-change verification
# and password-change notifications. In OSS mode leave Enabled=false.
ApiConfiguration__Email__Enabled=false
ApiConfiguration__Email__Smtp__Host=CHANGE_ME
ApiConfiguration__Email__Smtp__Port=587
ApiConfiguration__Email__Smtp__Username=CHANGE_ME
ApiConfiguration__Email__Smtp__Password=CHANGE_ME
ApiConfiguration__Email__Smtp__UseStartTls=true
ApiConfiguration__Email__From__Address=no-reply@vitalitynutri.com
ApiConfiguration__Email__From__Name=VitalityNutri
# Public base URL used to build verification links sent by email (no trailing slash).
ApiConfiguration__Email__Links__PublicBaseUrl=https://CHANGE_ME

# External service keys
ApiConfiguration__ExternalServices__Unsplash__AccessKey=CHANGE_ME

# Authentication secret salt & OAuth
ApiConfiguration__Auth__JwtSecret=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET_SALT_MINIMUM_64_CHARACTERS
ApiConfiguration__Auth__Google__Enabled=false
ApiConfiguration__Auth__Google__ClientId=CHANGE_ME
ApiConfiguration__Auth__Apple__Enabled=false
ApiConfiguration__Auth__Apple__ClientId=CHANGE_ME
ApiConfiguration__Auth__Apple__TeamId=CHANGE_ME
ApiConfiguration__Auth__Apple__KeyId=CHANGE_ME

# Upload Configuration (in Megabytes)
# Default is 15MB. Ensure this matches or exceeds FRONTEND_MAX_UPLOAD_SIZE_MB.
ApiConfiguration__Upload__MaxFileSizeMb=15

