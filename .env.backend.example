# VitalityNutri backend environment
# Copy to .env.backend and replace every CHANGE_ME value.
# This file is loaded only by the backend container. Never expose these values to Vite.

# Keep only private/secret values in this file.
# Non-sensitive defaults (mode, provider, URLs, model aliases, etc.) belong in appsettings.
# Set this to Development on a development VPS; Production is the container default.
ASPNETCORE_ENVIRONMENT=Production

# Database secret
ApiConfiguration__ConnectionStrings__Default=Server=host.docker.internal;Port=3306;Database=vitalitynutri;User ID=CHANGE_ME;Password=CHANGE_ME;SslMode=Preferred;

# AI secret keys
ApiConfiguration__Ai__OmniRoute__ApiKey=CHANGE_ME
ApiConfiguration__Ai__Providers__Gemini__ApiKey=CHANGE_ME
ApiConfiguration__Ai__Providers__Groq__ApiKey=CHANGE_ME

# External service keys
ApiConfiguration__ExternalServices__Unsplash__AccessKey=CHANGE_ME
