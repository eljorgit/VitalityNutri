# Dependencies
node_modules/

# Build artifacts (regenerated inside Docker)
dist/
build/
**/bin/
**/obj/
test-results/
coverage/

# Local environment files (secrets are injected at runtime by Compose/CI)
.env*
!.env.backend.example
!.env.frontend.example

# SQLite database and uploaded files
data/

# Git
.git/
.gitignore

# Editor / OS
.DS_Store
*.log
.vscode/
.idea/

# Docker definitions are not copied by project-specific COPY instructions.
